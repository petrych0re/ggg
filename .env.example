# Copy this file to .env and replace every placeholder locally.
# Never commit .env or share screenshots containing secret values.

# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token

# OpenAI API key. API usage is billed separately from a ChatGPT subscription.
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
AI_ENABLED=1

# Use /myid in Telegram to see your own numeric ID, then put it here.
# Replace these example IDs with your own Telegram ID.
BOT_ALLOWED_TELEGRAM_IDS=123456789
ADMIN_ID=123456789
GITHUB_ALLOWED_TELEGRAM_IDS=123456789

# Fine-grained GitHub token. Keep repository permissions read-only.
GITHUB_TOKEN=replace_with_github_token

# Optional MySQL history. Set to 1 only after importing setup_telegram_ai.sql in Navicat.
MYSQL_ENABLED=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_DATABASE=telegram_ai
